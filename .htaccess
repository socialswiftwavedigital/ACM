Options +FollowSymLinks
RewriteEngine On
RewriteBase /

# Redirect .html URLs to clean URLs (301 permanent)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Product category clean URLs: /product-category/creams -> category.html
RewriteRule ^product-category/([^/]+)/?$ category.html [L,QSA]

# Serve .html file when clean URL is requested
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
